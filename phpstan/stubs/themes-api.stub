 *   slug?: string,
 *   per_page?: int,
 *   page?: int,
 *   number?: int,
 *   search?: string,
 *   tag?: string,
 *   author?: string,
 *   user?: string,
 *   browse?: string,
 *   locale?: string,
 *   fields?: array<string, bool>
 * } $args
 */
function themes_api( $action, $args = array() ) {
